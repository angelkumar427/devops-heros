# Copy to terraform.tfvars (git-ignored) and adjust. No credentials belong in this file -
# Terraform reads them from `aws configure` / environment variables.
region      = "ap-south-1"
environment = "capstone"
owner       = "your-name"

# Strongly recommended: only your own IP may reach the Kubernetes API, e.g. ["203.0.113.7/32"]
api_allowed_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2

# false = no NAT gateway / Elastic IP; nodes run in the public subnets (see variables.tf)
enable_nat_gateway = true
